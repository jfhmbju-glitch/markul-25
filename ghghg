      <span class="icon">Я</span>
      <span class="name">Яндекс Музыка</span>
      <span class="arrow">›</span>
    </a>

    <a class="platform vk" href="https://vk.ru/audio-2001089226_149089226_13fbfae76ebcbef708" target="_blank" rel="noopener">
      <span class="icon">VK</span>
      <span class="name">VK Музыка</span>
      <span class="arrow">›</span>
    </a>

    <a class="platform spotify" href="https://open.spotify.com/track/1gEJ2sWFXsdHwTJhcG78ey?si=ae3865db5d964a12" target="_blank" rel="noopener">
      <span class="icon">●</span>
      <span class="name">Spotify</span>
      <span class="arrow">›</span>
    </a>

    <a class="platform soundcloud" href="https://soundcloud.com/markulmusic/25a?si=7ed5aa334d8f4246b24da48978e6ef4c&utm_source=clipboard&utm_medium=text&utm_campaign=social_sharing" target="_blank" rel="noopener">
      <span class="icon">☁</span>
      <span class="name">SoundCloud</span>
      <span class="arrow">›</span>
    </a>
  </div>

  <div class="footer">MARKUL · 25</div>
</main>
</body>
</html>
