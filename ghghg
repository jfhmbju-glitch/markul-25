<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#09090b">
<title>Markul — 25</title>

<style>
*{box-sizing:border-box}

html,body{min-height:100%}

body{
  margin:0;
  min-height:100vh;
  padding:24px 16px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  font-family:Inter,Arial,sans-serif;
  background:
    radial-gradient(circle at 50% 15%,#38383d 0,transparent 32%),
    radial-gradient(circle at 10% 90%,#1c1c20 0,transparent 35%),
    #09090b;
}

.card{
  position:relative;
  width:100%;
  max-width:430px;
  padding:34px 20px 22px;
  text-align:center;
  overflow:hidden;
  border:1px solid rgba(255,255,255,.10);
  border-radius:28px;
  background:rgba(22,22,25,.82);
  box-shadow:0 24px 70px rgba(0,0,0,.55);
  backdrop-filter:blur(18px);
}

.card:before{
  content:"";
  position:absolute;
  width:230px;
  height:230px;
  left:50%;
  top:-150px;
  transform:translateX(-50%);
  border-radius:50%;
  background:rgba(255,255,255,.08);
  filter:blur(10px);
}

.cover{
  position:relative;
  width:112px;
  height:112px;
  margin:0 auto 22px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:24px;
  background:linear-gradient(145deg,#29292e,#0e0e10);
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 16px 35px rgba(0,0,0,.45);
}

.cover img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  border-radius:inherit;
}

h1{
  position:relative;
  margin:0 0 7px;
  font-size:31px;
  line-height:1.1;
  letter-spacing:-1px;
}

.subtitle{
  position:relative;
  margin:0 0 25px;
  color:#a8a8ad;
  font-size:15px;
}

.links{
  display:grid;
  gap:12px;
}

.platform{
  position:relative;
  display:flex;
  align-items:center;
  gap:14px;
  min-height:62px;
  padding:10px 16px;
  color:#fff;
  text-decoration:none;
  border-radius:17px;
  border:1px solid rgba(255,255,255,.10);
  overflow:hidden;
  transition:transform .18s ease,filter .18s ease,box-shadow .18s ease;
}

.platform:hover{
  transform:translateY(-2px);
  filter:brightness(1.08);
}

.platform:active{
  transform:scale(.98);
}

.icon{
  flex:0 0 40px;
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  border-radius:12px;
  font-weight:900;
  font-size:21px;
  background:rgba(0,0,0,.18);
}

.name{
  flex:1;
  text-align:left;
  font-size:17px;
  font-weight:750;
}

.arrow{
  color:rgba(255,255,255,.60);
  font-size:22px;
  line-height:1;
}

.yandex{
  background:linear-gradient(135deg,#ff3131,#d90b32);
  box-shadow:0 9px 25px rgba(240,20,50,.22);
}
.yandex .icon{font-family:Arial,sans-serif}

.vk{
  background:linear-gradient(135deg,#1687f8,#0077ff);
  box-shadow:0 9px 25px rgba(0,119,255,.22);
}
.vk .icon{font-size:16px;letter-spacing:-1px}

.spotify{
  background:linear-gradient(135deg,#1ed760,#0b9f45);
  box-shadow:0 9px 25px rgba(29,215,96,.20);
}
.spotify .icon{font-size:24px}

.soundcloud{
  background:linear-gradient(135deg,#ff8a00,#ff4b00);
  box-shadow:0 9px 25px rgba(255,100,0,.20);
}
.soundcloud .icon{font-size:18px}

.footer{
  margin:22px 0 0;
  color:#68686e;
  font-size:11px;
  letter-spacing:.3px;
}

@media(max-width:380px){
  .card{padding:28px 15px 19px;border-radius:24px}
  .cover{width:96px;height:96px}
  h1{font-size:28px}
  .platform{min-height:58px;padding:9px 13px}
}
</style>
</head>

<body>
<main class="card">
